<Window x:Class="OrderBuddy.ScreenManager.App.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrderBuddy - First-Run Setup"
        Width="820"
        Height="620"
        WindowStartupLocation="CenterScreen"
        Background="#131B22">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Set up your screens" FontSize="26" Foreground="#F1F1F1" FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryText"
                       Text="Detected displays"
                       FontSize="14"
                       Foreground="#9FB0C0"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   Foreground="#C7D2DD"
                   FontSize="13"
                   Margin="0,14,0,6"
                   Text="Enter the web address each screen should open. You can type it with or without https://. Everything can be changed later from Admin Settings (Ctrl+Shift+F12, PIN 1234)."/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
            <ItemsControl x:Name="ScreenRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1B2733" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.RowSpan="3" Width="54" Height="54" CornerRadius="27"
                                        Background="#0096FF" VerticalAlignment="Top" Margin="0,2,16,0">
                                    <TextBlock Text="{Binding Number}" Foreground="White" FontSize="22"
                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayLabel}"
                                           Foreground="#8FA3B4" FontSize="12" Margin="0,0,0,6"/>

                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Screen name" Foreground="#9FB0C0" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox Width="180" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Type" Foreground="#9FB0C0" FontSize="11" Margin="0,0,0,2"/>
                                        <ComboBox Width="150" ItemsSource="{Binding AppTypes}" SelectedItem="{Binding SelectedAppType}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBlock Text="Web address (URL)" Foreground="#9FB0C0" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="14" Padding="4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="ValidationText" Foreground="#FF7A7A" VerticalAlignment="Center"
                       Margin="0,0,16,0" Text=""/>
            <Button Content="Cancel" Width="110" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="FinishButton" Content="Finish &amp; Apply" Width="150" Click="Finish_Click"
                    Background="#0096FF" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
