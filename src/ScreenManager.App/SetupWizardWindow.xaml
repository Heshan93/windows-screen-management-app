<Window x:Class="OrderBuddy.ScreenManager.App.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="First-Run Wizard"
        Width="760"
        Height="500"
        WindowStartupLocation="CenterOwner"
        Background="#131B22">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StepTitle" FontSize="24" Foreground="#F1F1F1" FontWeight="SemiBold" Text="Step 1 of 5 - Welcome"/>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock x:Name="StepBody" TextWrapping="Wrap" Foreground="#D6D6D6" FontSize="16"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Back" Width="110" Margin="0,0,8,0" Click="Back_Click"/>
            <Button x:Name="NextButton" Content="Next" Width="110" Click="Next_Click"/>
        </StackPanel>
    </Grid>
</Window>
