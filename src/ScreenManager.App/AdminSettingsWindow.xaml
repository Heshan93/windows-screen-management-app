<Window x:Class="OrderBuddy.ScreenManager.App.AdminSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OrderBuddy.ScreenManager.App.ViewModels"
        xmlns:config="clr-namespace:OrderBuddy.ScreenManager.Core.Config;assembly=ScreenManager.Core"
        Title="OrderBuddy Settings"
        Width="1200"
        Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#0E141B">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Displays">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Display Wall" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border BorderThickness="1" BorderBrush="#334455" CornerRadius="8" Padding="8" MinHeight="270">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding DisplayTiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="560" Height="240"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DisplayTileViewModel}">
                                            <Border Width="{Binding TileWidth}"
                                                    Height="{Binding TileHeight}"
                                                    BorderThickness="1"
                                                    BorderBrush="#6688AA"
                                                    Background="#1A2530"
                                                    CornerRadius="6"
                                                    Padding="6">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="0,2,6,0"/>
                                                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" Foreground="#F0F7FF"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding BoundsText}" FontSize="11" Foreground="#BFD0E1"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#9ED0FF"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <Button Content="Identify screens" Margin="0,8,0,0" Click="IdentifyScreens_Click"/>
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0"
                                 ItemsSource="{Binding Screens}"
                                 SelectedItem="{Binding SelectedScreen}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AdminScreenItemViewModel}">
                                    <StackPanel Orientation="Horizontal" Margin="4">
                                        <CheckBox IsChecked="{Binding Enabled}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="180"/>
                                        <TextBlock Text="{Binding DisplayKey}" Foreground="#99BBDD"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"/>
                            <TextBox Text="{Binding SelectedScreen.Name, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,0,12,8" TextChanged="MarkDirty_TextChanged"/>
                            <TextBlock Text="App Type" Grid.Row="0" Grid.Column="2" Margin="0,0,8,8"/>
                            <ComboBox Grid.Row="0" Grid.Column="3" SelectedItem="{Binding SelectedScreen.AppType}" SelectionChanged="MarkDirty_SelectionChanged">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="{x:Type config:AppType}">
                                        <config:AppType>Till</config:AppType>
                                        <config:AppType>Kiosk</config:AppType>
                                        <config:AppType>Menu</config:AppType>
                                        <config:AppType>Kds</config:AppType>
                                        <config:AppType>Collection</config:AppType>
                                        <config:AppType>Promo</config:AppType>
                                        <config:AppType>Custom</config:AppType>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                            <TextBlock Text="URL" Grid.Row="1" Grid.Column="0" Margin="0,0,8,8"/>
                            <TextBox Text="{Binding SelectedScreen.Url, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" TextChanged="MarkDirty_TextChanged"/>

                            <TextBlock Text="Rotation" Grid.Row="2" Grid.Column="0" Margin="0,0,8,8"/>
                            <TextBox Text="{Binding SelectedScreen.RotationDegrees}" Grid.Row="2" Grid.Column="1" Margin="0,0,12,8" TextChanged="MarkDirty_TextChanged"/>
                            <TextBlock Text="Zoom %" Grid.Row="2" Grid.Column="2" Margin="0,0,8,8"/>
                            <TextBox Text="{Binding SelectedScreen.ZoomPercent}" Grid.Row="2" Grid.Column="3" Margin="0,0,0,8" TextChanged="MarkDirty_TextChanged"/>

                            <TextBlock Text="Reload sec" Grid.Row="3" Grid.Column="0" Margin="0,0,8,8"/>
                            <TextBox Text="{Binding SelectedScreen.ReloadIntervalSec}" Grid.Row="3" Grid.Column="1" Margin="0,0,12,8" TextChanged="MarkDirty_TextChanged"/>
                            <TextBlock Text="Startup sec" Grid.Row="3" Grid.Column="2" Margin="0,0,8,8"/>
                            <TextBox Text="{Binding SelectedScreen.StartupDelaySec}" Grid.Row="3" Grid.Column="3" Margin="0,0,0,8" TextChanged="MarkDirty_TextChanged"/>

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Vertical" Margin="0,4,0,0">
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Content="Full Screen" IsChecked="{Binding SelectedScreen.FullScreen}" Margin="0,0,14,0" Checked="MarkDirty_Toggled" Unchecked="MarkDirty_Toggled"/>
                                    <TextBlock Text="Fallback mode" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Width="140" SelectedValuePath="Content" SelectedValue="{Binding SelectedScreen.FallbackMode}" SelectionChanged="MarkDirty_SelectionChanged" Margin="0,0,12,0">
                                        <ComboBoxItem Content="branded"/>
                                        <ComboBoxItem Content="image"/>
                                        <ComboBoxItem Content="customHtml"/>
                                    </ComboBox>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Text="Fallback image" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="250" Text="{Binding SelectedScreen.FallbackImagePath, UpdateSourceTrigger=PropertyChanged}" TextChanged="MarkDirty_TextChanged" Margin="0,0,12,0"/>
                                    <TextBlock Text="Fallback HTML" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="250" Text="{Binding SelectedScreen.FallbackHtmlPath, UpdateSourceTrigger=PropertyChanged}" TextChanged="MarkDirty_TextChanged"/>
                                </WrapPanel>
                                <WrapPanel>
                                <Button Content="Apply Preset" Margin="0,0,8,0" Click="ApplyPreset_Click"/>
                                <Button Content="Test URL" Margin="0,0,8,0" Click="TestUrl_Click"/>
                                <TextBlock Text="{Binding TestUrlResult}" VerticalAlignment="Center" Foreground="#88DD88"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="General">
                <StackPanel Margin="14">
                    <TextBlock Text="General settings are loaded from config and applied live." FontSize="16"/>
                    <TextBlock Text="Use Save to persist changes." Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Advanced">
                <StackPanel Margin="14">
                    <Button Content="Run First-Run Wizard" Width="220" Click="RunWizard_Click"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Diagnostics">
                <StackPanel Margin="14">
                    <TextBlock Text="Diagnostics" FontSize="18" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding DiagnosticsText}" Height="400" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh" Margin="0,0,8,0" Click="RefreshDiagnostics_Click"/>
                        <Button Content="Connectivity test" Margin="0,0,8,0" Click="ConnectivityTest_Click"/>
                        <Button Content="Restart all screens" Margin="0,0,8,0" Click="RestartAll_Click"/>
                        <Button Content="Export support bundle" Click="ExportBundle_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="About">
                <StackPanel Margin="14">
                    <TextBlock Text="OrderBuddy Screen Manager v2" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="P7 admin UX shell" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="Unsaved changes"
                       Foreground="#FFCC66"
                       Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Save" Width="120" Margin="0,0,8,0" Click="Save_Click"/>
                <Button Content="Close" Width="120" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
