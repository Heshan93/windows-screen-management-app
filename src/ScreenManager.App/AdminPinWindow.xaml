<Window x:Class="OrderBuddy.ScreenManager.App.AdminPinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin PIN"
        Width="340"
        Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#101418">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Enter Admin PIN"
                   FontSize="22"
                   Foreground="#F2F2F2"
                   FontWeight="SemiBold"/>

        <PasswordBox x:Name="PinBox"
                     Grid.Row="1"
                     Margin="0,12,0,12"
                     FontSize="24"
                     HorizontalContentAlignment="Center"/>

        <UniformGrid Grid.Row="2" Rows="4" Columns="3" Margin="0,4,0,0">
            <Button Content="1" Click="Digit_Click" Margin="4"/>
            <Button Content="2" Click="Digit_Click" Margin="4"/>
            <Button Content="3" Click="Digit_Click" Margin="4"/>
            <Button Content="4" Click="Digit_Click" Margin="4"/>
            <Button Content="5" Click="Digit_Click" Margin="4"/>
            <Button Content="6" Click="Digit_Click" Margin="4"/>
            <Button Content="7" Click="Digit_Click" Margin="4"/>
            <Button Content="8" Click="Digit_Click" Margin="4"/>
            <Button Content="9" Click="Digit_Click" Margin="4"/>
            <Button Content="Clear" Click="Clear_Click" Margin="4"/>
            <Button Content="0" Click="Digit_Click" Margin="4"/>
            <Button Content="⌫" Click="Backspace_Click" Margin="4"/>
        </UniformGrid>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Foreground="#FFCC66" Margin="0,0,0,8"/>
            <Button Content="Unlock" Height="34" Click="Unlock_Click"/>
        </StackPanel>
    </Grid>
</Window>
