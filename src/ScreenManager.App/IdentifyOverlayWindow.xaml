<Window x:Class="OrderBuddy.ScreenManager.App.IdentifyOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="360"
        Height="220">
    <Border Background="#CC101820" CornerRadius="20" BorderBrush="#66AADD" BorderThickness="2" Padding="14">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="DisplayNumberText" FontSize="72" FontWeight="Bold" Foreground="#FFF3F7FB" HorizontalAlignment="Center"/>
            <TextBlock x:Name="DisplayNameText" FontSize="16" Foreground="#FFCCE5FF" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
